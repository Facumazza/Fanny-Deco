# Backend env vars — copy to `.env` and fill in.
# These are read by application.yml via ${VAR:default} substitution.
#
# ==============================================================================
# DEV vs PROD
# ==============================================================================
# In DEV: none of these are strictly required — application.yml has defaults
# for anything you leave blank (admin/artesa passwords, empty API keys, etc.).
#
# In PROD: run with SPRING_PROFILES_ACTIVE=prod. application-prod.yml then
# REQUIRES every variable marked "PROD REQUIRED" below and the app will
# refuse to start if any is missing. This is intentional — better a crash
# at boot than silently coming up with "changeme123" as the admin password.
# ==============================================================================

# ---- Database (PROD REQUIRED) ----
# In dev the app connects to localhost:5433/artesa with user/pass artesa/artesa
# (see docker-compose.yml). In prod, override with your managed Postgres:
# ARTESA_DB_URL=jdbc:postgresql://your-host:5432/artesa
# ARTESA_DB_USER=artesa_app
# ARTESA_DB_PASSWORD=  # a strong, random password

# ---- Admin account (seeded on first startup) ----
# ARTESA_ADMIN_EMAIL=admin@artesa.com          # PROD REQUIRED
# ARTESA_ADMIN_PASSWORD=changeme123            # PROD REQUIRED — use a real one

# ---- Payments (MercadoPago) ----
# Sandbox access token from https://www.mercadopago.com.ar/developers/panel/app
# (create an application, then copy the "Access Token" from the credentials tab).
MERCADOPAGO_ACCESS_TOKEN=TEST-1234567890-abcdef

# HMAC secret used to verify incoming webhooks are actually from MercadoPago.
# In the MP dashboard: Notificaciones → Webhooks → Firma → "Generar secreto".
# In DEV: when empty, webhooks pass through with a startup warning.
# In PROD: REQUIRED. The app refuses to start without it — otherwise anyone
# who finds /api/webhooks/mercadopago could POST a fake payment id and
# push arbitrary orders to PAID.
MERCADOPAGO_WEBHOOK_SECRET=

# ---- Bank transfer (alternative to MP) ----
# Enable/disable the "pagar por transferencia" option on checkout. When
# enabled, the checkout shows CBU + Alias to the customer; they transfer
# manually and the admin flips the order to PAID from the admin panel.
# ARTESA_BANK_TRANSFER_ENABLED=true
# ARTESA_BANK_TRANSFER_BANK_NAME=Banco Galicia
# ARTESA_BANK_TRANSFER_ACCOUNT_HOLDER=Fanny Deco
# ARTESA_BANK_TRANSFER_CBU=0070XXXXXXXXXXXXXXXXXX
# ARTESA_BANK_TRANSFER_ALIAS=FANNY.DECO.CBU
# ARTESA_BANK_TRANSFER_CUIT=20-XXXXXXXX-X
# Where the customer should send the receipt (WhatsApp or email).
# ARTESA_BANK_TRANSFER_CONTACT_METHOD=WhatsApp al +54 9 11 1234-5678

# ---- Uploads storage (Cloudflare R2) — PROD REQUIRED ----
# In dev the backend uses the local filesystem (./uploads/); in prod it MUST
# use R2 because Railway containers are ephemeral and rebuilds wipe the disk.
# All 5 are required when SPRING_PROFILES_ACTIVE=prod.
# From Cloudflare dashboard → R2 → your bucket → Settings → S3 API tokens.
# R2_ACCOUNT_ID=<cloudflare-account-id>
# R2_ACCESS_KEY_ID=<from-r2-api-token>
# R2_SECRET_ACCESS_KEY=<from-r2-api-token>
# R2_BUCKET=fannydeco-uploads
# Enable public access on the bucket, then paste the pub-<hash>.r2.dev URL
# (no trailing slash), or a custom domain if you set one up.
# R2_PUBLIC_BASE_URL=https://pub-XXXXX.r2.dev

# Provider selector. Use `mercadopago` in dev/prod, `fake` in tests only.
ARTESA_PAYMENT_PROVIDER=mercadopago

# Public URL of the backend as reachable from MercadoPago's servers.
# In dev this is your ngrok URL — the ngrok CLI prints it when you run
# `ngrok http 8080`. It changes every session on the free tier.
# Do NOT include a trailing slash.
ARTESA_PUBLIC_BASE_URL=https://YOUR-SUBDOMAIN.ngrok-free.app

# Public URL of the frontend where MP will redirect the customer.
# Locally, this is your Vite dev server.
ARTESA_FRONTEND_BASE_URL=http://localhost:5173

# ---- Emails (Resend) ----
# `resend` for real sending, or `console` to log emails to stdout (dev default).
ARTESA_EMAIL_PROVIDER=console

# API key from https://resend.com/api-keys (starts with `re_`).
RESEND_API_KEY=

# Sender header for all customer emails. Domain must be verified in Resend.
ARTESA_EMAIL_FROM=ARTESA <no-reply@artesa.com>

# Where "new sale" notifications land.
ARTESA_EMAIL_ADMIN_TO=admin@artesa.com

# Brand name that appears at the top of every email.
ARTESA_EMAIL_SHOP_NAME=ARTESA
