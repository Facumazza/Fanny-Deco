# Backend env vars — copy to `.env` and fill in.
# These are read by application.yml via ${VAR:default} substitution.

# ---- Admin account (seeded on first startup) ----
# ARTESA_ADMIN_EMAIL=admin@artesa.com
# ARTESA_ADMIN_PASSWORD=changeme123

# ---- Payments (MercadoPago) ----
# Sandbox access token from https://www.mercadopago.com.ar/developers/panel/app
# (create an application, then copy the "Access Token" from the credentials tab).
MERCADOPAGO_ACCESS_TOKEN=TEST-1234567890-abcdef

# Provider selector. Use `mercadopago` in dev/prod, `fake` in tests only.
ARTESA_PAYMENT_PROVIDER=mercadopago

# Public URL of the backend as reachable from MercadoPago's servers.
# In dev this is your ngrok URL — the ngrok CLI prints it when you run
# `ngrok http 8080`. It changes every session on the free tier.
# Do NOT include a trailing slash.
ARTESA_PUBLIC_BASE_URL=https://YOUR-SUBDOMAIN.ngrok-free.app

# Public URL of the frontend where MP will redirect the customer.
# Locally, this is your Vite dev server.
ARTESA_FRONTEND_BASE_URL=http://localhost:5173
